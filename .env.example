# Copy to .env and adjust. Docker Compose reads this file automatically.
#
# .env is gitignored. Nothing in this example file is a real secret.

# --- Datastores -------------------------------------------------------------
# Local Docker Compose defaults. For MongoDB Atlas use the SRV connection
# string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/urlshortener
MONGODB_URI=mongodb://mongo:27017/urlshortener

REDIS_HOST=redis
REDIS_PORT=6379
# Leave blank for a local container. Required for Redis Cloud / Upstash.
REDIS_PASSWORD=

# --- Application ------------------------------------------------------------
# The origin used to build returned short URLs. Set this to your real domain
# in production or the API will hand out localhost links.
APP_BASE_URL=http://localhost:8080

SERVER_PORT=8080
LOG_LEVEL=INFO

# counter = collision-free, sequential-but-scrambled slugs
# random  = unguessable slugs, retries on the rare collision
APP_SLUG_STRATEGY=counter

# --- Security ---------------------------------------------------------------
# Only enable behind a reverse proxy that OVERWRITES X-Forwarded-For.
# If the app is internet-facing, leaving this true lets any caller forge their
# IP and bypass rate limiting entirely.
APP_TRUST_PROXY=false

# MUST be replaced with a long random value before any real deployment.
# Visitor hashes are only pseudonymous if this salt is secret: without it,
# hashing all 2^32 IPv4 addresses reverses every hash in the database.
# Generate one with: openssl rand -hex 32
APP_IP_SALT=replace-me-with-a-long-random-value
